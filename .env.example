# Invoice Flow - Environment Configuration
# Copy this to .env.local for local development or .env.production for cloud deployment

# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Get these from your Supabase project settings: https://app.supabase.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# ============================================
# VERCEL DEPLOYMENT
# ============================================
# This is your deployed backend URL
# For local dev: http://localhost:3000
# For production: https://your-project.vercel.app
VITE_API_BASE_URL=https://your-project.vercel.app

# ============================================
# APPLICATION SETTINGS
# ============================================
NODE_ENV=production
VITE_APP_NAME=Invoice Flow
VITE_APP_VERSION=1.1.3

# ============================================
# OPTIONAL: Authentication
# ============================================
# You can add additional authentication providers here if needed
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret
